---
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import GithubIcon from '../icons/GithubIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import DownloadIcon from '../icons/DownloadIcon.astro';

// Animaciones con React

import SplitText from './react/SplitText';
import AnimatedContent from './react/AnimatedContent';

---

<AnimatedContent client:load
  distance={100}
  direction="vertical"
  reverse={false}
  duration={0.8}
  ease="power3.out"
  initialOpacity={0}
  animateOpacity
  scale={1}
  threshold={0.1}
  delay={0}
>
  

<section class="flex flex-row gap-x-10 md:gap-x-20 justify-center items-center flex-wrap lg:flex-nowrap">
    <div class="flex flex-col justify-center mr-10">
            <h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold flex flex-row gap-x-4 pb-6 lg:pb-6">Hey,<br>
                soy Gabriel
				<a 
				 href="https://www.linkedin.com/in/gabriel-s%C3%A1nchez-flores-044a65310/"
				 target="_blank"
				 rel="noopener"
				 class="flex justify-center items-center"
				>
				 <Badge>Disponible para trabajar</Badge>
				</a>
            </h1>
            <div class="">
				<SplitText client:load
                text="Desarrollador Full-Stack & Técnico Informático"
                className="text-xl font-semibold text-white text-center"
                delay={100}
                duration={1.5}
                ease="power3.out"
                splitType="words"
                from={{ opacity: 0, y: 40 }}
                to={{ opacity: 1, y: 0 }}
                threshold={0.1}
                rootMargin="-100px"
                textAlign="center"
                />
            </div>

			<h3 class="text-xl mt-5 text-wrap max-w-[700px]">
				<span>1 año de experiencia. </span><span class=" text-emerald-300">Tecnico Informático, Desarrollador Full-Stack y estudiante de Grado Superior de Desarrollo de Aplicaciones Web (1º curso).</span>
				<span class="text-violet-200"> De Barcelona, España.</span>
            </h3>

			<nav class="flex gap-4 mt-7 flex-wrap">
				<SocialPill href="https://www.linkedin.com/in/gabriel-s%C3%A1nchez-flores-044a65310/">
					<LinkedInIcon class="size-4 md:size=6" />
					LinkedIn
				</SocialPill>

				<SocialPill href="https://github.com/K1rb1-30">
					<GithubIcon class="size-4 md:size=6" />
					Github
				</SocialPill>

				<SocialPill href="mailto:e.gsanchezf@ies-sabadell.cat">
					<MailIcon class="size-4 md:size=6" />
					e.gsanchezf@ies-sabadell.cat
				</SocialPill>

                <SocialPill href="/CVGabrielSanchezFlores.pdf" >
					<DownloadIcon class="size-4 md:size=6" />
					Ver CV
				</SocialPill>
			</nav>
    </div>

    <div>
        <img class="rounded-xl size-60" src="https://avatars.githubusercontent.com/u/168423128?v=4" alt="Foto de perfil"/>
    </div>
</section>

</AnimatedContent>

			