---
import Badge from '../components/Badge.astro';
import SocialPill from '../components/SocialPill.astro';
import LinkedInIcon from '../icons/LinkedInIcon.astro';
import GithubIcon from '../icons/GithubIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import DownloadIcon from '../icons/DownloadIcon.astro';

// Animaciones con React

import SplitText from './react/SplitText';
import AnimatedContent from './react/AnimatedContent';

---

<AnimatedContent client:load
  distance={100}
  direction="vertical"
  reverse={false}
  duration={0.8}
  ease="power3.out"
  initialOpacity={0}
  animateOpacity
  scale={1}
  threshold={0.1}
  delay={0}
>
  

<section class="flex flex-col lg:flex-row gap-6 md:gap-10 lg:gap-x-20 justify-center items-center lg:flex-wrap">
    <div class="flex flex-col justify-center items-center lg:items-start w-full lg:w-auto px-4">
            <h1 class="text-white text-2xl md:text-4xl lg:text-5xl font-bold flex flex-col sm:flex-row gap-x-4 gap-y-2 pb-4 md:pb-6 text-center sm:text-left">
                <span>Hey,</span>
                <span>soy Gabriel</span>
                <a 
                 href="https://www.linkedin.com/in/gabriel-s%C3%A1nchez-flores-044a65310/"
                 target="_blank"
                 rel="noopener"
                 class="flex justify-center sm:justify-start items-center"
                >
                 <Badge>Disponible para trabajar</Badge>
                </a>
            </h1>
            <div class="w-full">
                <SplitText client:load
                text="Desarrollador Full-Stack & Técnico Informático"
                className="text-lg md:text-xl font-semibold text-white text-center"
                delay={100}
                duration={1.5}
                ease="power3.out"
                splitType="words"
                from={{ opacity: 0, y: 40 }}
                to={{ opacity: 1, y: 0 }}
                threshold={0.1}
                rootMargin="-100px"
                textAlign="center"
                />
            </div>

            <h3 class="text-base md:text-xl mt-5 text-wrap max-w-[700px] text-center lg:text-left">
                <span>1 año de experiencia. </span><span class="text-emerald-300">Tecnico Informático, Desarrollador Full-Stack y estudiante de Grado Superior de Desarrollo de Aplicaciones Web (1º curso).</span>
                <span class="text-violet-200"> De Barcelona, España.</span>
            </h3>

            <nav class="flex gap-3 md:gap-4 mt-7 flex-wrap justify-center lg:justify-start w-full">
                <SocialPill href="https://www.linkedin.com/in/gabriel-s%C3%A1nchez-flores-044a65310/">
                    <LinkedInIcon class="size-4 md:size-5 lg:size-6" />
                    <span class="hidden sm:inline">LinkedIn</span>
                </SocialPill>

                <SocialPill href="https://github.com/K1rb1-30">
                    <GithubIcon class="size-4 md:size-5 lg:size-6" />
                    <span class="hidden sm:inline">Github</span>
                </SocialPill>

                <SocialPill href="mailto:contactogabrielsf@gmail.com">
                    <MailIcon class="size-4 md:size-5 lg:size-6" />
                    <span class="hidden sm:inline">contactogabrielsf@gmail.com</span>
                </SocialPill>

                <SocialPill href="https://www.canva.com/design/DAFviIZmNQc/QE_JP8-Zo_DAEH8WnfVA-Q/view?utm_content=DAFviIZmNQc&utm_campaign=designshare&utm_medium=link2&utm_source=uniquelinks&utlId=hd1c4b44cf3" alt="CV de Gabriel Sánchez Flores">
                    <DownloadIcon class="size-4 md:size-5 lg:size-6" />
                    <span class="hidden sm:inline">Ver CV</span>
                </SocialPill>
            </nav>
    </div>

    <div class="flex justify-center">
        <img class="rounded-xl size-48 sm:size-56 md:size-60" src="https://avatars.githubusercontent.com/u/168423128?v=4" alt="Foto de perfil"/>
    </div>
</section>

</AnimatedContent>

			