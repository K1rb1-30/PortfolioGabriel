---
import Layout from '../layouts/Layout.astro';
import Experience from '../components/Experience.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Home from '../components/Home.astro';
import BriefCase from '../icons/BriefCase.astro';
import CodeIcon from '../icons/CodeIcon.astro';
import StudiesIcon from '../icons/StudiesIcon.astro';
import Projects from '../components/Projects.astro';
import AboutMe from '../components/AboutMe.astro';
import Studies from '../components/Studies.astro';
import MailIcon from '../icons/MailIcon.astro';
import Contact from '../components/Contact.astro';


// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout 
	title="Porfolio de Gabriel - Tecnico Informático, Desarrollador y Programador Full-Stack con 1 año de experiencia"
	description='Contrata a Gabriel para crear aplicaciones web'

>
	<main class="px-4">
		<SectionContainer class="py-44 pb-32">
			<Home />
		</SectionContainer>

		<SectionContainer id="sobre-mi">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size=7" />
				Sobre mí
			</h2>
			
			<AboutMe />
		</SectionContainer>
		<SectionContainer id="experiencia">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<BriefCase class="size=7" />
				Experiencia laboral
			</h2>
			
			<Experience />
		</SectionContainer>

		<SectionContainer id="Estudios">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<StudiesIcon class="size=7" />
				Estudios
			</h2>

			<Studies />
		</SectionContainer>
		<SectionContainer id="proyectos">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<CodeIcon class="size=7" />
				Proyectos
			</h2>
			
			<Projects />
		</SectionContainer>

		<SectionContainer id="contacto">
			<h2 class="text-3xl font-semibold mb-6 flex gap-x-3 items-center">
				<MailIcon class="size=7" />
				Contacto
			</h2>
			
			<p class="text-lg mb-4">
				¿Interesado en trabajar conmigo o tienes alguna pregunta? No dudes en contactarme a través de mi correo electrónico:
				<div class="flex justify-center">
					<a href="mailto:contactogabrielsf@gmail.com" class="text-white-400 hover:underline">
						<button class="p-3 m-4 bg-violet-400 rounded-2xl ease-in-out hover:scale-105 hover:shadow-lg transition ">contactogabrielsf@gmail.com</button>
					</a>
				</div> 
				
			</p>
			<!-- <Contact /> -->
		</SectionContainer>

	</main>
</Layout>
